{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edinaldofox/EF-GPU/schemas/design-proposal.schema.json",
  "title": "EF-GPU design proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "design_id", "base_commit", "model", "artifacts", "changes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proposal_id": {"type": "string", "minLength": 1},
    "design_id": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "minLength": 7},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "seed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "temperature": {"type": "number", "minimum": 0},
        "context_sources": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rtl", "testbench", "sdc"],
      "properties": {
        "rtl": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "testbench": {"type": "string", "minLength": 1},
        "sdc": {"type": "string", "minLength": 1},
        "openroad_config": {"type": "string"}
      }
    },
    "changes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
